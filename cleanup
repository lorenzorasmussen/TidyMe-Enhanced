    initialize_database
    
    # Handle command line arguments
    case "${1:-}" in
        "scan")
            find_duplicates_advanced
            ;;
        "clean-cache")
            cleanup_caches_advanced
            ;;
        "clean-temp")
            cleanup_temp_advanced
            ;;
        "clean-dev")
            cleanup_development_advanced
            ;;
        "clean-all")
            echo -e "${YELLOW}⚠️ Complete Cleanup Selected (Safety Level: 🟡 CAUTION)${NC}"
            confirm_action "Proceed with complete cleanup? This will run all cleanup operations"
            cleanup_caches_advanced
            cleanup_temp_advanced
            cleanup_development_advanced
            generate_report
            ;;
        "report")
            generate_report
            ;;
        "daemon-start")
            start_daemon
            ;;
        "daemon-stop")
            stop_daemon
            ;;
        "system")
            cleanup_system_advanced
            ;;
        "help"|"--help"|"-h")
            show_help
            ;;
        "")
            # Interactive mode
            while true; do
                show_menu
                echo -n "Select option [0-10]: "
                read -r choice
                
                case $choice in
                    1)
                        echo -e "${BLUE}Running quick scan...${NC}"
                        find_duplicates_advanced
                        generate_report
                        ;;
                    2)
                        find_duplicates_advanced
                        ;;
                    3)
                        cleanup_caches_advanced
                        ;;
                    4)
                        cleanup_temp_advanced
                        ;;
                    5)
                        cleanup_development_advanced
                        ;;
                    6)
                        cleanup_system_advanced
                        ;;
                    7)
                        generate_report
                        ;;
                    8)
                        start_daemon
                        ;;
                    9)
                        stop_daemon
                        ;;
                    10)
                        echo -e "${YELLOW}⚠️ Complete Cleanup Selected (Safety Level: 🟡 CAUTION)${NC}"
                        confirm_action "Proceed with complete cleanup? This will run all cleanup operations"
                        cleanup_caches_advanced
                        cleanup_temp_advanced
                        cleanup_development_advanced
                        generate_report
                        ;;
                    0)
                        echo -e "${GREEN}Goodbye!${NC}"
                        exit 0
