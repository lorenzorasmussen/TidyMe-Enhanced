#!/usr/bin/env bash

# Enhanced macOS System Cleanup Service with Safety Protocols
# Version: 2.1
# Features: Duplicate detection, semantic search, CLI interface, database logging, safety protocols

set -euo pipefail

echo "🧹 Enhanced macOS System Cleanup Service with Safety Protocols"
echo ""
echo "🛡️ Safety Classification System"
echo "  🟢 SAFE - No risk, files regenerate automatically"
echo "  🟡 CAUTION - Low risk, may require app restart"
echo "  🟠 WARNING - Medium risk, backup recommended"
echo "  🔴 DANGER - High risk, expert review required"
echo ""

# Configuration - Use relative paths for better portability
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATA_DIR="$SCRIPT_DIR/data"
LOG_DIR="$DATA_DIR"
DB_PATH="$DATA_DIR/cleanup.db"
LOG_FILE="$LOG_DIR/cleanup.log"
PID_FILE="$DATA_DIR/cleanup-daemon.pid"
BACKUP_DIR="$HOME/backups/tidyme-backup-$(date +%Y%m%d-%H%M%S)"

# Create directories if they don't exist
mkdir -p "$DATA_DIR"
mkdir -p "$LOG_DIR"

# Ensure log file exists and is writable
if ! touch "$LOG_FILE" 2>/dev/null; then
    echo "Warning: Cannot create log file at $LOG_FILE"
    LOG_FILE="/tmp/tidyme-cleanup.log"
    touch "$LOG_FILE" 2>/dev/null || { echo "Cannot create log file, exiting"; exit 1; }
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Safety Classification function
safety_status() {
    local level="$1"
    case "$level" in
        "SAFE") echo -e "${GREEN}🟢 SAFE${NC}" ;;
        "CAUTION") echo -e "${YELLOW}🟡 CAUTION${NC}" ;;
        "WARNING") echo -e "${YELLOW}🟠 WARNING${NC}" ;;
        "DANGER") echo -e "${RED}🔴 DANGER${NC}" ;;
        *) echo -e "${BLUE}$level${NC}" ;;
    esac
}

# Load configuration file
load_config() {
    if [ -f "$SCRIPT_DIR/config.json" ]; then
        # Extract retention policies from config
        if command -v jq >/dev/null 2>&1; then
            # Use jq if available
            CACHE_MIN_AGE=$(jq -r '.cleanup.cache.min_age_days' "$SCRIPT_DIR/config.json" 2>/dev/null || echo 3)
            TEMP_MIN_AGE=$(jq -r '.cleanup.temp.min_age_days' "$SCRIPT_DIR/config.json" 2>/dev/null || echo 1)
            DEV_MIN_AGE=$(jq -r '.cleanup.dev.min_age_days' "$SCRIPT_DIR/config.json" 2>/dev/null || echo 14)
        else
            # Fallback values
            CACHE_MIN_AGE=3
            TEMP_MIN_AGE=1
            DEV_MIN_AGE=14
        fi
    else
        CACHE_MIN_AGE=3
        TEMP_MIN_AGE=1
        DEV_MIN_AGE=14
    fi
}

# Logging function
log() {
    local message="$(date '+%Y-%m-%d %H:%M:%S') - $1"
    echo "$message" | tee -a "$LOG_FILE"
}

# Interactive confirmation function
confirm_action() {
    local action_desc="$1"
    read -r -p "⚠️  $action_desc (y/N): " response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo "❌ Operation cancelled by user"
        exit 0
    fi
}

# Backup function
create_backup() {
    local backup_type="$1"
    local source_path="$2"
    
    if [[ -d "$source_path" ]]; then
        echo "💾 Creating backup of $backup_type..."
        mkdir -p "$BACKUP_DIR" || { echo "❌ Backup directory creation failed"; exit 1; }
        
        if cp -R "$source_path" "$BACKUP_DIR/" 2>/dev/null; then
            echo "✅ $backup_type backup successful: $BACKUP_DIR"
            log "Backup: $backup_type backed up to $BACKUP_DIR"
        else
            echo "⚠️ $backup_type backup failed, but continuing..."
            log "Backup: $backup_type backup failed"
        fi
    else
        echo "⏭️ $backup_type not found, skipping backup"
    fi
}

# Create self-healing restore script
create_restore_script() {
    cat > "$BACKUP_DIR/restore.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "🔄 RESTORE FROM BACKUP"
echo "======================"
BACKUP_DIR="$(cd "$(dirname "$0")" && pwd)"

restore_component() {
    local name="$1" component="$2"
    if [[ -d "$BACKUP_DIR/$component" ]]; then
        echo "📁 Restoring $name..."
        mkdir -p "$HOME/Library/$component"
        if rsync -a --delete "$BACKUP_DIR/$component/" "$HOME/Library/$component/" 2>/dev/null; then
            echo "✅ $name restored successfully"
        elif cp -R "$BACKUP_DIR/$component/"* "$HOME/Library/$component/" 2>/dev/null; then
            echo "✅ $name restored via fallback method"
        else
            echo "⚠️ $name restore failed"
        fi
    else
        echo "⏭️ $name backup not found"
    fi
}

restore_component "Caches" "Caches"
restore_component "Logs" "Logs"
restore_component "Preferences" "Preferences"
echo "✅ Restore complete!"
EOF

    chmod +x "$BACKUP_DIR/restore.sh"
    echo "🔧 Restore script created: $BACKUP_DIR/restore.sh"
}

# Database functions
db_execute() {
    sqlite3 "$DB_PATH" "$1"
}

db_insert_scan() {
    local scan_type="$1"
    local files_found="$2"
    local total_size="$3"
    local status="$4"
    
    db_execute "INSERT INTO scans (scan_type, files_found, total_size, status) VALUES ('$scan_type', $files_found, $total_size, '$status');"
    db_execute "SELECT last_insert_rowid();"
}

db_insert_file() {
    local scan_id="$1"
    local path="$2"
    local size="$3"
    local hash="$4"
    local file_type="$5"
    local last_access="$6"
    local last_modified="$7"
    
    db_execute "INSERT OR REPLACE INTO files (scan_id, path, size, hash, file_type, last_access, last_modified) VALUES ($scan_id, '$path', $size, '$hash', '$file_type', '$last_access', '$last_modified');"
}

